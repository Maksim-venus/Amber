    "cueCount": 2513,
    "head": [
      {
        "startMs": 160,
        "endMs": 2440,
        "text": "好的在前几次课的时候"
      },
      {
        "startMs": 2440,
        "endMs": 5930,
        "text": "我们讲了呃怎么用AI的一些案例对吧"
      },
      {
        "startMs": 5930,
        "endMs": 8490,
        "text": "就像我刚才给大家现场教学了一下"
      },
      {
        "startMs": 8490,
        "endMs": 10680,
        "text": "你们应该怎么把AI整合到"
      },
      {
        "startMs": 10680,
        "endMs": 11800,
        "text": "你们生活的流程当中"
      },
      {
        "startMs": 11800,
        "endMs": 14640,
        "text": "因为你们在生活中会遇到无穷多这种不顺心"
      },
      {
        "startMs": 14640,
        "endMs": 17080,
        "text": "就是你你你用很多东西时都会感到不顺心"
      },
      {
        "startMs": 17080,
        "endMs": 21100,
        "text": "但是呃AI作为一个非常强大的呃assistant呢"
      },
      {
        "startMs": 21100,
        "endMs": 23930,
        "text": "它可以帮你把不顺心的事情给挡掉"
      },
      {
        "startMs": 23930,
        "endMs": 25650,
        "text": "你只需要告诉他你的意图"
      },
      {
        "startMs": 25650,
        "endMs": 27370,
        "text": "真实的意图是什么啊"
      },
      {
        "startMs": 27370,
        "endMs": 27770,
        "text": "就可以了"
      },
      {
        "startMs": 27770,
        "endMs": 29690,
        "text": "然后你甚至还可以蒸馏成skills"
      },
      {
        "startMs": 29690,
        "endMs": 32370,
        "text": "然后让这个过程变得呃更平顺"
      },
      {
        "startMs": 32370,
        "endMs": 33790,
        "text": "而且在这个过程当中"
      },
      {
        "startMs": 33790,
        "endMs": 38180,
        "text": "我们不断的看到这个新的模型的进展啊"
      },
      {
        "startMs": 38180,
        "endMs": 40260,
        "text": "GPT6有就真的发布了"
      },
      {
        "startMs": 40260,
        "endMs": 41540,
        "text": "大家用用用上了嘛"
      },
      {
        "startMs": 41540,
        "endMs": 42700,
        "text": "然后我用用了一下"
      },
      {
        "startMs": 42700,
        "endMs": 44300,
        "text": "反正还是有有惊喜的"
      }
    ]
