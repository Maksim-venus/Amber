# Dependencies
node_modules/

# Build output
/dist/
/src/desktop/target/

# Generated by `pnpm build` and the Tauri CLI; rewritten on every build
/src/desktop/gen/
/src/desktop/permissions/autogenerated/

# Test reports
/test-results/
/playwright-report/

# External tools installed by `pnpm setup:tools`, verified against SHA256SUMS
/.amber-tools/

# Runtime Assets: the local working copy and the `gh release download` directory
/amber-runtime-assets/
/runtime-assets/

# Local configuration and data; they hold credentials and must never be committed
/.env
/.env.*
/.amber-dev/

# Changelog
/CHANGELOG.md

# Local working files
/.claude/
/images/
/scripts/

# Logs
*.log

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
